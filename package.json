{
  "name": "ryten-bench",
  "version": "0.1.0",
  "description": "RytenBench - AI-Powered Desktop Workspace",
  "main": "./out/main/index.js",
  "author": "https://github.com/Aitenry",
  "homepage": "https://github.com/Aitenry",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "npm run build:sandbox && electron-vite dev",
    "build:plugins": "node scripts/build-plugins.mjs",
    "build:sandbox": "node native/build-sandbox.mjs",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build:sandbox && npm run build:plugins && electron-vite build && electron-builder --dir",
    "build:win": "npm run build:sandbox && npm run build:plugins && electron-vite build && electron-builder --win --publish never",
    "build:mac": "npm run build:sandbox && npm run build:plugins && electron-vite build && electron-builder --mac --publish never",
    "build:linux": "npm run build:sandbox && npm run build:plugins && electron-vite build && electron-builder --linux --publish never"
  },
